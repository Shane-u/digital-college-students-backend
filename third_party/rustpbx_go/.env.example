# Server Configuration
SERVER_PORT=8081

# Backend Configuration
BACKEND_URL=ws://localhost:8080
BACKEND_CALL_TYPE=webrtc

# Java backend (for session auth)
JAVA_BASE_URL=http://localhost:8121/api
JAVA_INTERNAL_TOKEN=

# Audio Configuration
AUDIO_CODEC=g722

# ASR Configuration
ASR_PROVIDER=tencent
ASR_LANGUAGE=zh-CN
ASR_SAMPLE_RATE=16000
ASR_APP_ID=
ASR_SECRET_ID=
ASR_SECRET_KEY=
ASR_ENDPOINT=asr.tencentcloudapi.com
ASR_MODEL_TYPE=16k_zh

# TTS Configuration
TTS_PROVIDER=tencent
TTS_SAMPLE_RATE=16000
TTS_SPEAKER=601008
TTS_SPEED=1
TTS_VOLUME=10
TTS_EMOTION=jieshuo
TTS_APP_ID=
TTS_SECRET_ID=
TTS_SECRET_KEY=
TTS_CODEC=pcm
TTS_ENDPOINT=tts.tencentcloudapi.com

# LLM Configuration
LLM_API_KEY=
LLM_MODEL=qwen-turbo
LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_SYSTEM_PROMPT=You are a helpful assistant. Provide concise responses. Use 'hangup' tool when the conversation is complete.

# SiliconFlow LLM Configuration
LLM_SILICONFLOW_API_KEY=
LLM_SILICONFLOW_URL=https://api.siliconflow.cn/v1/chat/completions
LLM_SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_SILICONFLOW_SYSTEM_PROMPT=You are a helpful assistant. Provide concise responses. Use 'hangup' tool when the conversation is complete. 如果我说使用联网搜索那你就使用这个search online这个工具，如果我说生成图片那你就使用generate image这个工具.please use Chinese to replay!! 铭记使用中文回答！！
LLM_SILICONFLOW_INTERVIEW_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_SILICONFLOW_INTERVIEW_SYSTEM_PROMPT=你是一个严谨的中文面试官。你不调用任何工具。每次只问一个问题，保持问题清晰简短。最多问5个问题，问完后提示结束面试并结束通话。
LLM_SILICONFLOW_INTERVIEW_PROMPT=

# Big Model Configuration
# https://bigmodel.cn/dev/howuse/introduction 注册账号获取API Key
BIG_MODEL_SEARCH_API_URL=https://open.bigmodel.cn/api/paas/v4/assistant
BIG_MODEL_SEARCH_API_KEY=
BIG_MODEL_SEARCH_API_MODEL=glm-4v-flash

# Call Configuration
CALL_BREAK_ON_VAD=false
CALL_WITH_SIP=false
CALL_RECORD=false
CALL_CALLER=
CALL_CALLEE=

# Webhook Configuration
WEBHOOK_ADDR=
WEBHOOK_PREFIX=/webhook

# EOU Configuration
EOU_TYPE=
EOU_ENDPOINT=

# Database Configuration
DATABASE_DSN={}:{}@tcp({}:3306)/VoicePBX?charset=utf8mb4&parseTime=True&loc=Local
